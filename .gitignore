@'
# Python
__pycache__/
*.py[cod]
*.pyd
.Python
.venv/
venv/
env/

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/

# Environment variables and secrets
.env
.env.*
!.env.example

# Local databases and generated data
data/*.sqlite
data/*.sqlite3
data/*.db
data/*.db-journal
data/*.sqlite3-journal

# Logs
*.log

# Editors and operating system
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
'@ | Set-Content -Encoding utf8 .gitignore